        "item": [
          {
            "id": "19662a6d-a62a-422a-9c0d-02224dd13d25",
            "name": "Login - Get Access Token",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "login"
                ],
                "host": [
                  "{{baseUrl}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"contactNumber\": \"{{contactNumber}}\",\n  \"password\": \"{{password}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "64034b68-1c7b-4f51-bd79-2e6e74f38e92",
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 201) {",
                    "    var jsonData = pm.response.json();",
                    "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                    "    pm.test(\"Login successful\", function() {",
                    "        pm.expect(pm.response.code).to.equal(201);",
                    "        pm.expect(jsonData.accessToken).to.exist;",
                    "        pm.expect(jsonData.role).to.equal(\"admin\");",
                    "    });",
                    "}"
                  ],
                  "_lastExecutionId": "ac37ed44-7800-4b41-bcbf-922b7115e028"
                }
              }
            ]
          }
        ],
        "event": []
      },
