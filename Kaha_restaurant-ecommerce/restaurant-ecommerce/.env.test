# Test Environment Configuration
NODE_ENV=test

# Database Configuration (Local Test DB)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kaha_restaurant_test

# JWT Configuration
JWT_SECRET_TOKEN=test-secret-key-for-e2e-tests
JWT_EXPIRATION=1h

# Mock Auth (Enabled for E2E tests)
USE_MOCK_AUTH=true

# KAHA Main V3 API (Not used in mock mode)
KAHA_MAIN_V3_URL=http://localhost:3000

# Server Configuration
PORT=3001
