            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceAccountToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"externalUserId\": \"kaha-user-different\",\n    \"phone\": \"9801234567\",\n    \"firstName\": \"Different\",\n    \"lastName\": \"User\"\n  },\n  \"restaurant\": {\n    \"externalRestaurantId\": \"kaha-business-different\",\n    \"name\": \"Different Restaurant\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kaha-sync/user-restaurant",
              "host": ["{{baseUrl}}"],
              "path": ["kaha-sync", "user-restaurant"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
