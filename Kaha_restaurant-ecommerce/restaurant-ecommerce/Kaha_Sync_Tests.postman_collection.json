            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"externalUserId\": \"test\",\n    \"phone\": \"9801111111\"\n  },\n  \"restaurant\": {\n    \"externalRestaurantId\": \"test\",\n    \"name\": \"Test Restaurant\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kaha-sync/user-restaurant",
              "host": ["{{baseUrl}}"],
              "path": ["kaha-sync", "user-restaurant"]
            }
          },
          "response": []
